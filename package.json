{
  "name": "veeess-knits",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate:local": "wrangler d1 migrations apply veeess_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply veeess_db --remote",
    "catalog:export": "node scripts/export-catalog.mjs",
    "build:site": "astro build",
    "build": "npm run catalog:export && astro build",
    "dev": "node scripts/check-local.mjs --quiet && npm run build && wrangler dev --port 8787",
    "deploy": "node scripts/check-prod-config.mjs && npm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.worker.json && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "gen:vapid": "node scripts/gen-vapid.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "check:local": "node scripts/check-local.mjs",
    "check:prod": "node scripts/check-prod-config.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261024.1",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/instrument-sans": "5.1.0",
    "@types/node": "^22.20.5",
    "astro": "5.18.2",
    "typescript": "5.6.3",
    "vitest": "3.2.7",
    "wrangler": "4.152.0"
  }
}
