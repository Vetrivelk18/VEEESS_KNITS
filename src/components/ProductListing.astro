---
import ProductCard from './ProductCard.astro';
import { catalog, products, type Product } from '../lib/catalog';
import { showsOn } from '../../shared/audience';
type Aud = '' | 'men' | 'women' | 'kids';
interface Props { title: string; intro?: string; items: Product[]; activeCategory?: string; activeAudience?: Aud }
const { title, intro, items, activeCategory = '', activeAudience = '' } = Astro.props;

/** Listing URL for an audience + category pair, so the two filters combine (D47). */
const listHref = (aud: Aud, cat: string) => (aud ? `/${aud}/` : '/shop/') + (cat ? `${cat}/` : '');
const forLinks: { key: Aud; label: string }[] = [
  { key: '', label: 'Everyone' }, { key: 'men', label: 'Men' }, { key: 'women', label: 'Women' }, { key: 'kids', label: 'Kids' },
];
// Category chips: only categories that have products for the chosen audience.
const pool = activeAudience ? products.filter((p) => showsOn(activeAudience, p.audience)) : products;
const cats = catalog.categories.filter((c) => pool.some((p) => p.category.slug === c.slug));
const hasCat = (aud: Aud, cat: string) => !cat || products.some((p) => p.category.slug === cat && (!aud || showsOn(aud, p.audience)));
---
<section class="wrap">
  <div class="page-title">
    <h1 class="display h2">{title}</h1>
    {intro && <p class="muted" style="max-width:640px;margin:10px 0 0">{intro}</p>}
  </div>
  <nav class="chips chips-for" aria-label="Shop for">
    {forLinks.map((f) => (
      <a class="chip" href={listHref(f.key, hasCat(f.key, activeCategory) ? activeCategory : '')} aria-current={activeAudience === f.key ? 'page' : undefined}>{f.label}</a>
    ))}
  </nav>
  {cats.length > 1 && (
    <nav class="chips" aria-label="Categories">
      <a class="chip" href={listHref(activeAudience, '')} aria-current={activeCategory === '' ? 'page' : undefined}>All</a>
      {cats.map((c) => <a class="chip" href={listHref(activeAudience, c.slug)} aria-current={activeCategory === c.slug ? 'page' : undefined}>{c.name}</a>)}
    </nav>
  )}
  {items.length ? (
    <div class="product-grid" style="padding-bottom:40px">{items.map((p, i) => <ProductCard product={p} eager={i < 4} />)}</div>
  ) : (
    <div class="empty"><p>New styles are on the way. <a href={listHref(activeAudience, '')}>See all products</a></p></div>
  )}
</section>
