---
import Base from '../layouts/Base.astro';
import Lines from '../components/Lines.astro';
import { siteText } from '../lib/siteText';
import Icon from '../components/Icon.astro';
import ProductCard from '../components/ProductCard.astro';
import { catalog, products, categoryImage } from '../lib/catalog';
const newArrivals = products.filter((p) => p.is_new).slice(0, 4);
const featured = newArrivals.length >= 4 ? newArrivals : products.slice(0, 4);
const wordle = catalog.brands.find((b) => b.slug === 'wordle');
// Editable in admin → Site text (D50).
const steps = [1, 2, 3, 4, 5, 6].map((n) => [siteText[`about.step${n}.title`], siteText[`about.step${n}.text`]]);
---
<Base title="Veeess Knits — T-shirts and knitwear from Tiruppur" current="home">
  <section class="wrap hero">
    <div>
      <span class="pill">{siteText['hero.tag']}</span>
      <h1 class="display h1" style="margin-top:24px"><Lines k="hero.headline" /></h1>
      <p class="lead"><Lines k="hero.intro" /></p>
      <div style="display:flex;flex-wrap:wrap;gap:12px">
        <a class="btn" href="/shop/">Shop Wordle</a>
        <a class="btn btn-outline" href="#about">How we make them</a>
      </div>
    </div>
    <div class="hero-grid">
      <a class="tall" href="/p/cr7-oversized-tee/" aria-label="CR7 oversized tee"><img src="/images/home/hero-model.jpg" alt="Man in a blue oversized printed tee, sitting in a vintage convertible" width="854" height="1280" fetchpriority="high" style="object-position:center 30%" /></a>
      <a class="drop drop-photo" href="/shop/t-shirts/">
        <img src="/images/home/drop-shoulder-rack.jpg" alt="" width="904" height="701" style="object-position:30% center" />
        <span class="drop-label">{siteText['drop.label']}</span>
        <span class="big"><Lines k="drop.title" /></span>
      </a>
      <img src="/images/home/folded-polos.jpg" alt="Folded jacquard polo T-shirts on the rack of a bicycle" width="903" height="844" style="min-height:254px" />
    </div>
  </section>

  <section class="trust" aria-label="Why shop with us">
    <div class="wrap">
      <div><span class="num">15+</span><span>years of<br />manufacturing</span></div>
      <div><Icon name="shield" size={28} /><span>Export-standard<br />quality checks</span></div>
      <div><Icon name="chart" size={28} /><span>GSM &amp; shrinkage<br />tested fabric</span></div>
      <div><Icon name="cash" size={28} /><span>Secure online payment:<br />UPI, cards, netbanking</span></div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="cat-h">
    <div class="section-head">
      <h2 id="cat-h" class="display h2">Shop by category</h2>
      <a href="/shop/">View all products →</a>
    </div>
    <div class="cat-grid">
      {catalog.categories.map((c) => (
        <a class="cat-card" href={`/shop/${c.slug}/`}>
          <img src={categoryImage(c.slug)} alt="" loading="lazy" width="800" height="1000" />
          <span>{c.name}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap section" aria-labelledby="fit-h">
    <div class="section-head">
      <h2 id="fit-h" class="display h2">Find your fit</h2>
      <a href="/shop/t-shirts/">All T-shirts →</a>
    </div>
    <div class="fit-grid">
      <a class="fit-card" href="/shop/t-shirts/">
        <img src="/images/home/fit-fullsleeve.jpg" alt="Four friends on a mountain trail in full-sleeve textured tees" width="900" height="1130" loading="lazy" />
        <span class="fit-copy"><span class="fit-title">Full-sleeve textured tees</span><span class="fit-link">Shop now →</span></span>
      </a>
      <a class="fit-card" href="/shop/t-shirts/">
        <img src="/images/home/fit-tiedye.jpg" alt="Three friends in tie-dye graphic tees around a red car" width="900" height="1178" loading="lazy" />
        <span class="fit-copy"><span class="fit-title">Tie-dye graphic tees</span><span class="fit-link">Shop now →</span></span>
      </a>
      <a class="fit-card" href="/shop/t-shirts/">
        <img src="/images/home/fit-acidwash.jpg" alt="Four men in acid-wash oversized tees leaning on a car" width="900" height="1092" loading="lazy" />
        <span class="fit-copy"><span class="fit-title">Acid-wash oversized tees</span><span class="fit-link">Shop now →</span></span>
      </a>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="brand-h">
    <h2 id="brand-h" class="sr-only">Our label: Wordle</h2>
    <a class="wordle-feature" href="/shop/">
      <img src="/images/brand/wordle-wordmark.jpg" alt="Wordle" width="1015" height="536" loading="lazy" />
      <div class="wordle-copy">
        <span class="eyebrow">Our label · by Veeess</span>
        <p>{wordle?.tagline}</p>
        <span class="tag">Shop Wordle</span>
      </div>
    </a>
  </section>

  <section class="wrap section" aria-labelledby="new-h" style="padding-bottom:64px">
    <div class="section-head">
      <h2 id="new-h" class="display h2">New arrivals</h2>
      <a href="/shop/">Shop new →</a>
    </div>
    <div class="product-grid">
      {featured.map((p) => <ProductCard product={p} />)}
    </div>
  </section>

  <section class="wrap section" aria-labelledby="story-h">
    <div class="story">
      <a class="story-main" href="/shop/t-shirts/">
        <img src="/images/home/story-mountain.jpg" alt="Man in an oversized varsity-print tee looking over misty mountains" width="1600" height="1161" loading="lazy" />
        <span class="story-copy">
          <span class="eyebrow">Oversized fits</span>
          <h2 id="story-h" class="display story-title">Made to go further.</h2>
          <span class="tag">Shop T-shirts</span>
        </span>
      </a>
      <div class="story-side">
        <img src="/images/home/story-prints.jpg" alt="Close-up of folded tees with bold varsity prints" width="1000" height="765" loading="lazy" />
        <div class="story-note">
          <h3>Bold prints, soft cotton</h3>
          <p>Wear them on their own or layer them under a shirt or jacket for a different look every day.</p>
          <a href="/shop/">Shop all →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="look-h">
    <div class="section-head">
      <h2 id="look-h" class="display h2">Wear it your way</h2>
      <a href="/shop/">Shop the look →</a>
    </div>
    <div class="lookbook">
      <a href="/shop/t-shirts/"><img src="/images/home/look-1.jpg" alt="Friends in printed crew-neck tees with paddle boards" width="432" height="533" loading="lazy" /></a>
      <a href="/shop/"><img src="/images/home/look-2.jpg" alt="Group in polo T-shirts on a sofa" width="378" height="533" loading="lazy" /></a>
      <a href="/shop/t-shirts/"><img src="/images/home/look-3.jpg" alt="Men in graphic tees sitting on steps" width="382" height="533" loading="lazy" /></a>
      <a href="/shop/t-shirts/"><img src="/images/home/look-4.jpg" alt="Man in an oversized printed tee with a duffel bag" width="388" height="533" loading="lazy" /></a>
    </div>
  </section>

  <section id="about" class="band">
    <div class="wrap">
      <div>
        <span class="eyebrow">{siteText['about.eyebrow']}</span>
        <h2 class="display" style="font-size:clamp(32px,4vw,48px);margin:16px 0 20px"><Lines k="about.headline" /></h2>
        <p><Lines k="about.body" /></p>
        <a class="btn btn-accent" href="/shop/" style="margin-top:12px">{siteText['about.button']}</a>
      </div>
      <ol class="steps">
        {steps.map(([t, d], i) => <li><span class="n">0{i + 1}</span><span class="t">{t}</span><span class="d">{d}</span></li>)}
      </ol>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="studio-h">
    <div class="section-head">
      <h2 id="studio-h" class="display h2">Inside the studio</h2>
      <a href="https://www.instagram.com/wordle_byveeess/" rel="noopener noreferrer" target="_blank">Follow @wordle_byveeess →</a>
    </div>
    <div class="gallery">
      <img src="/images/products/studio-cutting.jpg" alt="Fabric rolls ready for cutting" loading="lazy" width="900" height="900" />
      <img src="/images/products/studio-stitching.jpg" alt="Finished tees on the rack" loading="lazy" width="900" height="900" />
      <img src="/images/products/studio-print.jpg" alt="Printed Wordle tee" loading="lazy" width="900" height="900" />
      <img src="/images/products/studio-qc.jpg" alt="Folded tees after quality check" loading="lazy" width="900" height="900" />
      <img src="/images/products/studio-packing.jpg" alt="Packed cartons ready to dispatch" loading="lazy" width="900" height="900" />
    </div>
  </section>
</Base>
