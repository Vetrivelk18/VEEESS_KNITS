---
import Base from '../../layouts/Base.astro';
import ProductListing from '../../components/ProductListing.astro';
import { catalog, products } from '../../lib/catalog';
export function getStaticPaths() {
  return catalog.brands.map((b) => ({ params: { brand: b.slug }, props: { b } }));
}
const { b } = Astro.props as { b: { name: string; slug: string; tagline: string } };
const items = products.filter((p) => p.brand.slug === b.slug);
---
<Base title={b.name} current={b.slug} description={`${b.name} by Veeess — ${b.tagline}`}>
  <ProductListing title={b.name} intro={b.tagline} items={items} brandSlug={b.slug} />
</Base>
