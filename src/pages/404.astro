---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <div class="wrap" style="padding-block:64px;text-align:center">
    <h1 class="display h2">This page isn't here.</h1>
    <p class="muted">It may have moved, or the product is no longer available.</p>
    <p style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap"><a class="btn" href="/shop/">Shop all products</a><a class="btn btn-outline" href="/">Home</a></p>
  </div>
</Base>
