---
import Base from '../../layouts/Base.astro';
import ProductListing from '../../components/ProductListing.astro';
import { products } from '../../lib/catalog';
import { showsOn } from '../../../shared/audience';
const items = products.filter((p) => showsOn('kids', p.audience));
---
<Base title="Kids" current="kids" description="Shop Wordle for kids: Soft, easy-wear clothes for kids, from babies to teens. Made in our own unit in Tiruppur.">
  <ProductListing title="Kids" intro="Soft, easy-wear clothes for kids, from babies to teens. Made in our own unit in Tiruppur." items={items} activeAudience="kids" showCategories={false} />
</Base>
