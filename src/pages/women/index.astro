---
import Base from '../../layouts/Base.astro';
import ProductListing from '../../components/ProductListing.astro';
import { products } from '../../lib/catalog';
import { showsOn } from '../../../shared/audience';
const items = products.filter((p) => showsOn('women', p.audience));
---
<Base title="Women" current="women" description="Shop Wordle for women: T-shirts and everyday knitwear for women — including our unisex styles. Made in our own unit in Tiruppur.">
  <ProductListing title="Women" intro="T-shirts and everyday knitwear for women — including our unisex styles. Made in our own unit in Tiruppur." items={items} activeAudience="women" showCategories={false} />
</Base>
