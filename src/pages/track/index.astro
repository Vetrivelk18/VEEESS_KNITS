---
import Base from '../../layouts/Base.astro';
---
<Base title="Track your order" current="track" description="Track your Veeess Knits order with your order number and mobile number.">
  <div class="wrap prose">
    <div class="page-title"><h1 class="display h2">Track your order</h1></div>
    <p>Enter your order number and the mobile number you used at checkout to see your order status: confirmed, packed, shipped or delivered, with the courier and tracking number once it ships.</p>

    <form class="track-form" data-track-form novalidate>
      <div class="notice bad" data-track-error role="alert" hidden></div>
      <div class="form-grid">
        <label class="field">Order number<input name="orderNumber" required maxlength="20" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="e.g. VK-1042" /><span class="hint">In your order confirmation email</span></label>
        <label class="field">Mobile number<input name="phone" type="tel" inputmode="numeric" autocomplete="tel-national" required maxlength="17" placeholder="10-digit mobile" /><span class="hint">The one used when ordering</span></label>
      </div>
      <div data-turnstile style="min-height:65px;margin:14px 0"></div>
      <button type="submit" class="btn" data-track-submit>Track order</button>
    </form>

    <p class="muted" style="font-size:14px">Your order confirmation and “Your order has shipped” emails also have a private <strong>“View your order status”</strong> link that opens the same page.</p>
    <h2>Need help?</h2>
    <p>Call or WhatsApp us with your order number:</p>
    <p><a class="btn" href="tel:+919600577555">Call +91 96005 77555</a> <a class="btn btn-outline" href="https://wa.me/919600686606" rel="noopener noreferrer" target="_blank">WhatsApp us</a></p>
  </div>
  <script>
    import '../../scripts/track';
  </script>
</Base>
