---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
const STATES = [
  'Andaman and Nicobar Islands', 'Andhra Pradesh', 'Arunachal Pradesh', 'Assam', 'Bihar', 'Chandigarh',
  'Chhattisgarh', 'Dadra and Nagar Haveli and Daman and Diu', 'Delhi', 'Goa', 'Gujarat', 'Haryana',
  'Himachal Pradesh', 'Jammu and Kashmir', 'Jharkhand', 'Karnataka', 'Kerala', 'Ladakh', 'Lakshadweep',
  'Madhya Pradesh', 'Maharashtra', 'Manipur', 'Meghalaya', 'Mizoram', 'Nagaland', 'Odisha', 'Puducherry',
  'Punjab', 'Rajasthan', 'Sikkim', 'Tamil Nadu', 'Telangana', 'Tripura', 'Uttar Pradesh', 'Uttarakhand', 'West Bengal',
];
---
<Base title="Checkout" current="cart" noindex>
  <div class="wrap">
    <div class="page-title"><h1 class="display h2">Checkout</h1></div>
    <form class="cart-layout" data-checkout-form novalidate>
      <div class="main" style="gap:20px">
        <div class="notice bad" data-form-error role="alert" hidden></div>
        <fieldset>
          <legend>Contact</legend>
          <div class="form-grid">
            <label class="field full">Full name<input name="name" autocomplete="name" required minlength="2" maxlength="80" /></label>
            <label class="field">Mobile number<input name="phone" type="tel" inputmode="numeric" autocomplete="tel-national" required maxlength="14" placeholder="10-digit mobile" /><span class="hint">For delivery updates</span></label>
            <label class="field">Email<input name="email" type="email" autocomplete="email" required maxlength="120" /><span class="hint">Your order confirmation goes here</span></label>
          </div>
        </fieldset>
        <fieldset>
          <legend>Delivery address</legend>
          <div class="form-grid">
            <label class="field full">House / flat, street<input name="line1" autocomplete="address-line1" required minlength="3" maxlength="120" /></label>
            <label class="field full">Area, landmark (optional)<input name="line2" autocomplete="address-line2" maxlength="120" /></label>
            <label class="field">City / town<input name="city" autocomplete="address-level2" required maxlength="60" /></label>
            <label class="field">PIN code<input name="pincode" inputmode="numeric" autocomplete="postal-code" required pattern="[1-9][0-9]{5}" maxlength="6" /></label>
            <label class="field full">State
              <select name="state" autocomplete="address-level1" required>
                <option value="">Select state</option>
                {STATES.map((s) => <option value={s} selected={s === 'Tamil Nadu'}>{s}</option>)}
              </select>
            </label>
          </div>
        </fieldset>
        <fieldset>
          <legend>Payment</legend>
          <div style="display:flex;flex-direction:column;gap:10px">
            <label class="pay-opt"><input type="radio" name="paymentMethod" value="razorpay" checked /><span><span class="t">Pay online</span><br /><span class="s">UPI (GPay, PhonePe, Paytm), cards, netbanking — secured by Razorpay</span></span></label>
            <label class="pay-opt"><input type="radio" name="paymentMethod" value="cod" /><span><span class="t">Cash on delivery</span><br /><span class="s">Pay in cash at your door · no extra charge</span></span></label>
          </div>
        </fieldset>
        <div data-turnstile style="min-height:65px"></div>
        <label class="check"><input type="checkbox" name="consent" required /> <span>I agree to the <a href="/policies/terms/" target="_blank">terms</a> and <a href="/policies/privacy/" target="_blank">privacy policy</a>. My details are used only to deliver this order.</span></label>
        <div data-mock hidden class="notice" style="border-style:dashed">
          <strong>Test payment (local development only)</strong>
          <p style="margin:6px 0 12px" class="muted">Razorpay is simulated on this computer. In production the real Razorpay window opens here.</p>
          <div style="display:flex;gap:10px;flex-wrap:wrap"><button type="button" class="btn btn-sm" data-mock-pay>Simulate successful payment</button><button type="button" class="btn btn-sm btn-outline" data-mock-cancel>Cancel</button></div>
        </div>
      </div>
      <aside class="side">
        <div class="summary">
          <strong style="font-size:17px">Order summary</strong>
          <div data-items style="display:flex;flex-direction:column;gap:8px;font-size:14px"></div>
          <div class="r" style="border-top:1px solid var(--line);padding-top:10px"><span>Subtotal</span><span data-subtotal>—</span></div>
          <div class="r"><span>Shipping</span><span data-shipping>—</span></div>
          <div class="r" data-cod-row hidden><span>Cash on delivery charge</span><span class="free">Free</span></div>
          <div class="r total"><span>Total</span><span data-total>—</span></div>
          <button type="submit" class="btn btn-block" style="min-height:54px" data-submit>Pay securely</button>
          <p class="muted" style="font-size:12px;margin:0;display:flex;gap:6px;align-items:center;justify-content:center"><Icon name="lock" size={14} />Secured by Razorpay · Card details never touch our servers</p>
        </div>
      </aside>
    </form>
  </div>
  <script>
    import '../../scripts/checkout';
  </script>
</Base>
