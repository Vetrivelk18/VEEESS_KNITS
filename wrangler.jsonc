// Cloudflare Worker + static assets for veeessknits.com
// Static pages (built by Astro into ./dist) are served free and unlimited.
// Only /api/*, /media/* and /admin/* run the Worker code.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veeess-knits",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Admin pages run through the Worker so they are protected even if
    // Cloudflare Access is misconfigured (defence in depth).
    "run_worker_first": ["/api/*", "/media/*", "/admin", "/admin/*", "/__local/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "veeess_db",
      "database_id": "26c465ab-bbdc-4723-bf23-90a4fc9d14c2",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "veeess-media" }
  ],
  "triggers": {
    // Every 15 min: reconcile payments, expire unpaid orders, re-alert admins.
    // Sundays 21:00 UTC (Mon 02:30 IST): export a database backup to R2.
    "crons": ["*/15 * * * *", "0 21 * * SUN"]
  },
  "observability": { "enabled": true },
  // Non-secret settings. Secrets go in `wrangler secret put` (see README).
  // For local development, .dev.vars overrides these values.
  "vars": {
    "ENVIRONMENT": "production",
    // Phase A (testing): the workers.dev address. Change to https://www.veeessknits.com when the domain moves (Phase B).
    "SITE_URL": "https://veeess-knits.info-veeessknits.workers.dev",
    // Admins (2 now, a 3rd later). Must match the Cloudflare Access policy "Veeess admins" (README §2.3).
    "ADMIN_EMAILS": "vetrivelpandiank@gmail.com,info.veeessknits@gmail.com",
    "ACCESS_TEAM_DOMAIN": "veeessknits.cloudflareaccess.com",
    "ACCESS_AUD": "ee0dd178bd248bf09ea9f6d89c3eb19b4f155032084df851a1788a2abab6b2fe",
    "RAZORPAY_KEY_ID": "rzp_test_TstfMLHmKhnOUg",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFpVM1al0WbyCPFm",
    "VAPID_PUBLIC_KEY": "BAuXv3Vwv-qxXjbLUyNIY9QgDRW2F_AZIFu-xWiBBn6KNcXuuJG92fyKcCFgn7AFpoEKGaiC-SweqSwXZQr1do0",
    "VAPID_SUBJECT": "mailto:info.veeessknits@gmail.com",
    "EMAIL_FROM": "Veeess Knits <orders@veeessknits.com>",
    // New-order alert emails. Comma-separated for several inboxes (e.g. all 3 admins).
    "ALERT_EMAIL_TO": "info.veeessknits@gmail.com",
    // Delivery charge in paise (7900 = ₹79). 0 = free delivery. Set when courier rates are known.
    "SHIPPING_FEE_PAISE": "0",
    // Orders at or above this subtotal ship free. 0 = no free-delivery threshold.
    "FREE_SHIPPING_MIN_PAISE": "0",
    "COD_MAX_OPEN_PER_PHONE": "2",
    "COD_MAX_ORDER_PAISE": "0",
    "ORDER_EXPIRY_MINUTES": "30",
    "MEDIA_BASE_URL": "/media",
    "GITHUB_REPO": "Vetrivelk18/VEEESS_KNITS"
  }
}
